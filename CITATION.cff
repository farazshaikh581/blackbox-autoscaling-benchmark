    given-names: Faraz
type: software
license: Apache-2.0
repository-code: "https://github.com/farazshaikh581/blackbox-autoscaling-benchmark/tree/paper-artifact-v1"
keywords:
  - multi-objective optimization
  - kubernetes autoscaling
  - black-box benchmarking
  - evolutionary algorithms
  - reinforcement learning
  - energy efficiency
